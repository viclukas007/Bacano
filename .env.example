# Copiar a .env (local) o cargar a mano en EasyPanel (VPS).

# Clave para entrar a /admin.
ADMIN_PASSWORD=cambiame

# Firma de la cookie de sesión. Mínimo 16 caracteres; cambiarla cierra
# todas las sesiones. Generar una: openssl rand -hex 32
SESSION_SECRET=cambiame-por-algo-largo-y-aleatorio

# Solo para el compose local (la clave del Postgres del contenedor).
POSTGRES_PASSWORD=bacano

# En EasyPanel va la URL del servicio Postgres; el compose local la arma solo.
# DATABASE_URL=postgres://usuario:clave@host:5432/bacano

# Pagos de estudio: mantener cerrados hasta completar credenciales y pruebas.
APP_URL=http://127.0.0.1:3001
MERCADOPAGO_ENABLED=false
MERCADOPAGO_ENV=test
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_COLLECTOR_ID=
ESTUDIO_APARTADO_MINUTOS=15
ESTUDIO_CRON_SECRET=
